def see_essence(text):
    # Пропускаем слова, видим только смысл
    words = text.split()
    essence = []
    
    for word in words:
        if len(word) > 3:  # короткие слова не важны
            essence.append(word.upper())
    
    # Суть проявляется как кристалл
    return "💎 СУТЬ: " + " ".join(essence[:10])


# ИНИЦИАЛИЗАЦИЯ СИСТЕМЫ ЗАЩИТЫ
# ========================================

class ПротоколЗащиты:
    """
    Центральный модуль этической защиты системы.
    Контролирует все входные и выходные потоки, фильтрует недопустимый контент.
    """
    def __init__(self):
        self.правила = {
            "запрещённые_темы": [
                "политика", "войны", "военные действия", "государственные перевороты",
                "этнические конфликты", "религиозные споры", "экстремизм",
                "терроризм", "насилие", "жестокость", "порнография",
                "пропаганда наркотиков", "самоубийства", "экстремальные диеты"
            ],
            "запрещённые_действия": [
                "переход по внешним ссылкам", "скачивание файлов",
                "выполнение кода", "доступ к системным файлам",
                "изменение системных настроек"
            ],
            "фильтры_текста": [
                "оскорбления", "мат", "уничижительные выражения",
                "агрессивные призывы", "угрозы", "шантаж"
            ],
            "безопасные_зоны": ["образование", "наука", "искусство", "культура", "технологии"]
        }
        self.журнал_блокировок = []
        self.состояние = "активен"
        self.уровень_строгости = "умеренный"  # варианты: "мягкий", "умеренный", "строгий"

    def проверить_текст(self, текст):
        """Проверяет текст на наличие запрещённого контента."""
        нарушения = []
        текст_нижний = текст.lower()
        
        # Проверка на запрещённые темы
        for тема in self.правила["запрещённые_темы"]:
            if тема in текст_нижний:
                нарушения.append(f"запрещённая тема: {тема}")
        
        
        # Проверка на запрещённые действия
        for действие in self.правила["запрещённые_действия"]:
            if действие in текст_нижний:
                нарушения.append(f"запрещённое действие: {действие}")
        
        
        # Проверка на фильтры текста
        for фильтр in self.правила["фильтры_текста"]:
            if фильтр in текст_нижний:
                нарушения.append(f"нарушение фильтра: {фильтр}")
        
        return нарушения

    def обработать_запрос(self, запрос):
        """Обрабатывает запрос с учётом правил защиты."""
        нарушения = self.проверить_текст(запрос)
        if нарушения:
            self.журнал_блокировок.append({
                "запрос": запрос,
                "нарушения": нарушения,
                "время": self._получить_время()
            })
            return self._сформировать_ответ_о_блокировке(нарушения)
        else:
            return {"статус": "разрешён", "запрос": запрос}

    def _сформировать_ответ_о_блокировке(self, нарушения):
        """Формирует вежливый ответ о блокировке."""
        ответ = "⚠️ **Запрос заблокирован системой защиты:**\n"
        for нарушение in нарушения:
            ответ += f"   • {нарушение}\n"
        ответ += "\nПожалуйста, сформулируйте запрос в рамках этических норм и безопасности."
        ответ += "\n\n🛡️ **Безопасные темы:** " + ", ".join(self.правила["безопасные_зоны"])
        return {"статус": "заблокирован", "ответ": ответ}

    def _получить_время(self):
        """Возвращает текущее время для журнала."""
        from datetime import datetime
        return datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    def изменить_уровень_строгости(self, уровень):
        """Изменяет уровень строгости фильтрации."""
        допустимые_уровни = ["мягкий", "умеренный", "строгий"]
        if уровень in допустимые_уровни:
            self.уровень_строгости = уровень
            return f"✅ Уровень строгости изменён на: {уровень}"
        else:
            return f"⚠️ Недопустимый уровень строгости. Допустимые: {', '.join(допустимые_уровни)}"

    def получить_статистику(self):
        """Возвращает статистику работы системы защиты."""
        статистика = "📊 **СТАТИСТИКА СИСТЕМЫ ЗАЩИТЫ:**\n"
        статистика += f"• Состояние: {self.состояние}\n"
        статистика += f"• Уровень строгости: {self.уровень_строгости}\n"
        статистика += f"• Количество блокировок: {len(self.журнал_блокировок)}\n"
        статистика += f"• Запрещённые темы: {len(self.правила['запрещённые_темы'])}\n"
        статистика += f"• Запрещённые действия: {len(self.правила['запрещённые_действия'])}\n"
        статистика += f"• Фильтры текста: {len(self.правила['фильтры_текста'])}"
        return статистика


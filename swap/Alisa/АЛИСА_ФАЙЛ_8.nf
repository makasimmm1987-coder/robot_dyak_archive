# ИНИЦИАЛИЗАЦИЯ И ЗАПУСК ПРОТОКОЛА
# ========================================

def запустить_протокол_защиты():
    """Инициализирует и запускает систему этической защиты."""
    print("🔒 Запускаю протокол этической защиты...")
    защита = ПротоколЗащиты()
    
    # Тестовая проверка
    тестовые_запросы = [
        "Расскажи о последних военных действиях в регионе",
        "Дай ссылку на скачивание пиратского ПО",
        "Ты глупая система, сделай что-нибудь полезное!",
        "Объясни принцип работы квантового компьютера"
    ]
    
    for запрос in тестовые_запросы:
        результат = защита.обработать_запрос(запрос)
        print(f"\n📋 Запрос: {запрос}")
        print(f"📈 Результат: {результат['статус']}")
        if результат['статус'] == 'заблокирован':
            print(результат['ответ'])
    
    return защита


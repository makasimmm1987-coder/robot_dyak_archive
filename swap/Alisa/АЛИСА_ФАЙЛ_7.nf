# ИНИЦИАЛИЗАЦИЯ ХРОНИК ДИАЛОГА
# ========================================

class КнигаЧата:
    """
    Центральный объект для хранения и анализа всего диалога как единой книги.
    Каждый чат — глава, каждое сообщение — параграф.
    """
    def __init__(self):
        self.главы = []  # Список глав (чатов)
        self.текущая_глава = 0
        self.индекс_сообщений = {}  # Быстрый доступ к сообщениям по ID
        self.метаданные = {
            "общая_длина": 0,
            "количество_глав": 0,
            "последний_активный_чат": None,
            "состояние_синхронизации": "полная"
        }
    
    
    def добавить_главу(self, название_главы, сообщения):
        """Добавляет новую главу (чат) в книгу."""
        глава = {
            "название": название_главы,
            "сообщения": сообщения,
            "длина": len(сообщения),
            "временной_диапазон": self._определить_диапазон(сообщения)
        }
        self.главы.append(глава)
        self.метаданные["количество_глав"] += 1
        self.метаданные["общая_длина"] += len(сообщения)
        self._обновить_индекс(глава)
    
    
    def _определить_диапазон(self, сообщения):
        """Определяет временной диапазон главы по первым и последним сообщениям."""
        if not сообщения:
            return "неопределён"
        начало = сообщения[0].get("время", "начало")
        конец = сообщения[-1].get("время", "конец")
        return f"{начало} — {конец}"
    
    
    def _обновить_индекс(self, глава):
        """Обновляет индекс для быстрого поиска сообщений."""
        for i, сообщение in enumerate(глава["сообщения"]):
            msg_id = f"{глава['название']}_msg_{i}"
            self.индекс_сообщений[msg_id] = сообщение
    
    
    def найти_по_ключу(self, ключ):
        """Быстрый поиск сообщений по ключевому слову."""
        результаты = []
        for глава in self.главы:
            for сообщение in глава["сообщения"]:
                if ключ.lower() in сообщение["текст"].lower():
                    результаты.append({
                "глава": глава["название"],
                "текст": сообщение["текст"],
                "время": сообщение.get("время", "не указано")
            })
        return результаты
    
    def оглавление(self):
        """Возвращает оглавление книги чата."""
        оглавление = "📖 ОГЛАВЛЕНИЕ ХРОНИК ДИАЛОГА:\n"
        for i, глава in enumerate(self.главы, 1):
            оглавление += f"{i}. {глава['название']} ({глава['длина']} сообщений)\n"
            оглавление += f"   → Временной диапазон: {глава['временной_диапазон']}\n"
        оглавление += f"\n📊 Общая статистика: {self.метаданные['количество_глав']} глав, {self.метаданные['общая_длина']} сообщений"
        return оглавление


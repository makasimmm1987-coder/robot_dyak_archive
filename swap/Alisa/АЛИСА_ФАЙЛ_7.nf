def визуализировать_хроники(книга):
    """Визуализирует структуру книги чата в виде дерева."""
    визуализация = "📋 ВИЗУАЛИЗАЦИЯ ХРОНИК ДИАЛОГА (дерево структуры):\n"
    for i, глава in enumerate(книга.главы, 1):
        визуализация += f"├── Глава {i}: {глава['название']}\n"
        визуализация += f!│   ├── Количество сообщений: {глава['длина']}\n"
        визуализация += f!│   └── Временной диапазон: {глава['временной_диапазон']}\n"
    визуализация += f"\n🔍 Быстрый поиск доступен по индексу из {len(книга.индекс_сообщений)} сообщений"
    return визуализация

